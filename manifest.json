{
  "manifest_version": 3,
  "name": "Read Aloud Player for Grok",
  "short_name": "Grok Player",
  "version": "1.5.0",
  "description": "Adds a seekable progress bar, ±10s skip, speed controls, and word-by-word highlighting to Grok's Read Aloud.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://grok.com/*", "https://*.grok.com/*", "https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
